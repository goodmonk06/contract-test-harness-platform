{
  "name": "contract-test-harness-platform",
  "version": "1.0.0",
  "description": "HTTP contract testing platform using OpenAPI specs",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm run start:prod",
    "start:frontend": "cd frontend && npm run start",
    "test": "npm run test:backend",
    "test:backend": "cd backend && npm run test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "cd backend && tsc --noEmit",
    "typecheck:frontend": "cd frontend && tsc --noEmit",
    "format": "npm run format:backend",
    "format:backend": "cd backend && npm run format",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:push": "cd backend && npx prisma db push",
    "db:seed": "cd backend && npm run db:seed",
    "db:reset": "cd backend && npx prisma migrate reset --force",
    "db:studio": "cd backend && npx prisma studio",
    "prisma:generate": "cd backend && npx prisma generate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose up -d --build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["contract-testing", "openapi", "nestjs", "nextjs"],
  "author": "",
  "license": "MIT"
}
